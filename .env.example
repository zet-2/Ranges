GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MEDIA_RESOLUTION=high
GEMINI_TIMEOUT_MS=10000
VISION_LAYOUT=mosaic
SAVE_DEBUG_IMAGES=0
ANTHROPIC_API_KEY=your_anthropic_api_key
HERO_USERNAME=biba287
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5
PROMPT_MODE=FAST
CLAUDE_FAST_TIMEOUT_SECONDS=6.5
CLAUDE_COACH_TIMEOUT_SECONDS=15.0
FAST_REQUEST_TIMEOUT_SECONDS=12.0

# Optional local solver routing for a simulator you own/control.
# HYBRID uses GTO only for conservatively reconstructed HU postflop roots and
# first check/bet descendants; it falls back to Claude everywhere else.
STRATEGY_BACKEND=CLAUDE
GTO_LIVE_ENABLED=0
GTO_OWNED_SIMULATOR_ACK=0
GTO_ENGINE_PATH=/private/tmp/oracle-engine-target/release/gto-oracle-engine
GTO_CACHE_PATH=gto_live_cache.sqlite3
GTO_RANGE_DATA_PATH=poker_data.json
# `charts` preserves the old static range path. `blueprint` enables the
# validated PokerStudy NL v2 preflop policy and HU postflop range handoff.
GTO_RANGE_SOURCE=charts
PREFLOP_BLUEPRINT_CACHE_PATH=preflop_blueprint_cache
PREFLOP_BLUEPRINT_ALLOW_NETWORK=0
# exact: only the fixed source profile; abstract: nearest unique stack/action
# path within the explicit bounds below, with caveats printed in every answer.
PREFLOP_BLUEPRINT_MATCH_MODE=exact
PREFLOP_BLUEPRINT_MIN_TOLERANCE_BB=0.05
PREFLOP_BLUEPRINT_SIZE_TOLERANCE_PCT=0
PREFLOP_BLUEPRINT_MAX_STACK_ERROR_PCT=25
PREFLOP_BLUEPRINT_NETWORK_TIMEOUT_SECONDS=60
GTO_BET_SIZE_PCT=50
GTO_TARGET_EXPLOITABILITY_PCT=0.5
GTO_MAX_ITERATIONS=10000
GTO_FLOP_CACHE_ONLY=1
GTO_FLOP_TIMEOUT_SECONDS=4
GTO_TURN_TIMEOUT_SECONDS=2
GTO_RIVER_TIMEOUT_SECONDS=1
GTO_RAKE_RATE_PCT=0
GTO_RAKE_CAP_BB=0
