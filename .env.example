GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MEDIA_RESOLUTION=high
GEMINI_TIMEOUT_MS=10000
VISION_LAYOUT=mosaic
SAVE_DEBUG_IMAGES=0
# Optional observer-only local-CV sampler. It makes no OCR/model calls and
# never silently drops an unacknowledged keyframe.
LIVE_CAPTURE_ENABLED=0
LIVE_CAPTURE_FPS=8
LIVE_CAPTURE_MAX_PENDING=128
LIVE_CAPTURE_HEARTBEAT_SECONDS=5
# Experimental and default-off. This starts the same sampler even when
# LIVE_CAPTURE_ENABLED=0, makes at most one bounded Gemini request per stable
# keyframe, and publishes a snapshot/transcript pair only while every public
# transition is proved. Any capture/decode/queue ambiguity invalidates it.
PUBLIC_HISTORY_DECODER_ENABLED=0
PUBLIC_HISTORY_DECODE_TIMEOUT_SECONDS=8
# Required only when STRATEGY_BACKEND is CLAUDE or HYBRID.
ANTHROPIC_API_KEY=your_anthropic_api_key
HERO_USERNAME=biba287
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5
PROMPT_MODE=FAST
CLAUDE_FAST_TIMEOUT_SECONDS=6.5
CLAUDE_COACH_TIMEOUT_SECONDS=15.0
FAST_REQUEST_TIMEOUT_SECONDS=12.0

# Strict solver-only GTO is the default and never falls back to Claude.
# For a local trial of the current bounded HU postflop continuation, use
# GTO_HU. Use GTO_MULTIWAY only with the remote multiway-v3 protocol and an
# audited external solver. Both remain solver-only but accept only explicitly
# labelled finite-game approximations; neither calls Claude.
# Set both flags below to 1 only for a simulator you own/control. Until then,
# GTO fails closed. CLAUDE and HYBRID remain explicit opt-in backends.
STRATEGY_BACKEND=GTO
GTO_LIVE_ENABLED=0
GTO_OWNED_SIMULATOR_ACK=0
# `local` runs the HU Rust engine on this machine. `remote` uses the selected
# authenticated protocol after OCR/history validation.
GTO_EXECUTION_MODE=local
GTO_ENGINE_PATH=gto_oracle_engine/target/release/gto-oracle-engine
# Safe default. Increase only after moving the engine to a machine with enough
# physical RAM; the selected limit is echoed in every solver result.
GTO_ENGINE_MAX_MEMORY_GIB=8
GTO_CACHE_PATH=gto_live_cache.sqlite3
# Optional private seed for mixed-strategy realization. If omitted, a fresh
# cryptographic secret is generated at startup. Use at least 32 random bytes.
# GTO_MIX_SECRET=
GTO_RANGE_DATA_PATH=poker_data.json
# `blueprint` enables the validated PokerStudy NL v2 preflop policy and HU
# postflop range handoff. `charts` is approximate and strict GTO rejects it.
GTO_RANGE_SOURCE=blueprint
PREFLOP_BLUEPRINT_CACHE_PATH=preflop_blueprint_cache
PREFLOP_BLUEPRINT_ALLOW_NETWORK=0
# exact: only the fixed source profile; abstract: nearest unique stack/action
# path within the explicit bounds below, with caveats printed in every answer.
PREFLOP_BLUEPRINT_MATCH_MODE=exact
PREFLOP_BLUEPRINT_MIN_TOLERANCE_BB=0.05
PREFLOP_BLUEPRINT_SIZE_TOLERANCE_PCT=0
PREFLOP_BLUEPRINT_MAX_STACK_ERROR_PCT=25
PREFLOP_BLUEPRINT_NETWORK_TIMEOUT_SECONDS=60
GTO_BET_SIZE_PCT=50
GTO_TARGET_EXPLOITABILITY_PCT=0.1
GTO_MAX_ITERATIONS=1000000
GTO_FLOP_CACHE_ONLY=0
GTO_FLOP_TIMEOUT_SECONDS=180
GTO_TURN_TIMEOUT_SECONDS=5
GTO_RIVER_TIMEOUT_SECONDS=2
GTO_RAKE_RATE_PCT=5
GTO_RAKE_CAP_BB=0.5
# Public-event recorder. A full backend receives the transcript only when the
# Mac observed the untouched preflop frame and every subsequent public action.
GTO_TABLE_SMALL_BLIND_BB=0.5
GTO_TABLE_BIG_BLIND_BB=1
GTO_TABLE_ANTE_BB=0
GTO_EVENT_AMOUNT_TOLERANCE_BB=0.05

# Remote client settings. Required only with GTO_EXECUTION_MODE=remote.
# Keep GTO_REMOTE_ALLOW_INSECURE_HTTP=0 for public endpoints. Set it to 1 only
# for an HTTP endpoint reached through a trusted SSH/WireGuard loopback tunnel.
GTO_REMOTE_ENABLED=0
GTO_REMOTE_ENDPOINT=https://solver.example.com/v1/evaluate
# hu-v2 sends the current HU-shaped decision projection. multiway-v3 sends the
# canonical complete PublicHandHistory plus Hero seat/cards and accepts only a
# structured policy bound to the pinned capability manifest below.
GTO_REMOTE_PROTOCOL=hu-v2
# Required by multiway-v3. Keep an audited local copy of the exact server
# capability manifest; its SHA-256 identity is checked in every solved proof.
# GTO_REMOTE_CAPABILITIES_PATH=/absolute/path/to/capabilities.json
# Generate at least 32 private random bytes; never commit the real value.
GTO_REMOTE_AUTH_TOKEN=replace_with_at_least_32_random_bytes
GTO_REMOTE_TIMEOUT_SECONDS=300
GTO_REMOTE_MAX_REQUEST_BYTES=262144
GTO_REMOTE_MAX_RESPONSE_BYTES=1048576
GTO_REMOTE_ALLOW_INSECURE_HTTP=0
