# Copy to /etc/gto-oracle/container.env with mode 0600.
# Paths match the runtime image and its /data persistent volume.
GTO_REMOTE_AUTH_TOKEN=replace-with-at-least-32-random-bytes
GTO_API_SOURCE_URL=https://example.invalid/source-at-deployed-revision
GTO_SERVER_BACKEND=native
GTO_ENGINE_MAX_MEMORY_GIB=192
GTO_MIX_SECRET=replace-with-a-second-independent-32-byte-secret

GTO_TARGET_EXPLOITABILITY_PCT=0.1
GTO_MAX_ITERATIONS=1000000
GTO_FLOP_TIMEOUT_SECONDS=180
GTO_TURN_TIMEOUT_SECONDS=5
GTO_RIVER_TIMEOUT_SECONDS=2
GTO_FLOP_CACHE_ONLY=0
GTO_RAKE_RATE_PCT=5
GTO_RAKE_CAP_BB=0.5

GTO_RANGE_SOURCE=blueprint
PREFLOP_BLUEPRINT_ALLOW_NETWORK=0
PREFLOP_BLUEPRINT_MATCH_MODE=exact

# For an external backend, mount its executable, capability manifest, work
# directory, and license read-only; then set the equivalent GTO_EXTERNAL_*
# values documented in server.env.example.
