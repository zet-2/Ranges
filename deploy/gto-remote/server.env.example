# Store the real file as /etc/gto-oracle/server.env with mode 0600.
GTO_REMOTE_AUTH_TOKEN=replace-with-at-least-32-random-bytes
GTO_API_BIND=127.0.0.1
GTO_API_PORT=8787
GTO_API_MAX_REQUEST_BYTES=262144
GTO_API_IDEMPOTENCY_CACHE_ENTRIES=512
GTO_API_SOCKET_TIMEOUT_SECONDS=15
GTO_API_SOURCE_URL=https://example.invalid/source-at-deployed-revision

GTO_SERVER_BASE_DIR=/opt/gto-oracle
GTO_LIVE_ENABLED=1
GTO_OWNED_SIMULATOR_ACK=1
# `native` is the bundled fixed-preflop/HU-postflop router and accepts schema
# v2 only. `external` invokes one explicitly configured owned/licensed adapter,
# advertises schema v2/v3, and requires all GTO_EXTERNAL_* values below.
GTO_SERVER_BACKEND=native
GTO_ENGINE_PATH=/opt/gto-oracle/bin/gto-oracle-engine
# 96 for a 128-GiB host; 192 for 256 GiB; 288 for 384 GiB.
GTO_ENGINE_MAX_MEMORY_GIB=96
GTO_CACHE_PATH=/var/lib/gto-oracle/gto_live_cache.sqlite3
GTO_RANGE_SOURCE=blueprint
PREFLOP_BLUEPRINT_CACHE_PATH=/opt/gto-oracle/preflop_blueprint_cache
PREFLOP_BLUEPRINT_ALLOW_NETWORK=0
PREFLOP_BLUEPRINT_MATCH_MODE=exact

GTO_TARGET_EXPLOITABILITY_PCT=0.1
GTO_MAX_ITERATIONS=1000000
GTO_FLOP_TIMEOUT_SECONDS=180
GTO_TURN_TIMEOUT_SECONDS=5
GTO_RIVER_TIMEOUT_SECONDS=2
GTO_FLOP_CACHE_ONLY=0
GTO_RAKE_RATE_PCT=5
GTO_RAKE_CAP_BB=0.5

# Keep this stable and private so mixed-strategy realization remains stable
# across server restarts. It must contain at least 32 UTF-8 bytes.
GTO_MIX_SECRET=replace-with-a-second-independent-32-byte-secret

# External backend settings (server-only; ignored by `native`).
# The adapter reads protocol v2 for LiveDecisionState requests or transcript-
# first protocol v3 for MultiwayDecisionState requests. A v3 adapter must write
# a structured v3 mixed policy and convergence proof bound to the capability
# manifest fingerprint. The executable path must be absolute.
# GTO_EXTERNAL_COMMAND_JSON=["/opt/full-gto/bin/ranges-adapter","evaluate"]
# GTO_EXTERNAL_CAPABILITIES_PATH=/opt/full-gto/capabilities.json
# GTO_EXTERNAL_WORKDIR=/opt/full-gto
# GTO_EXTERNAL_ENV_JSON={"LICENSE_FILE":"/opt/full-gto/license.key"}
# GTO_EXTERNAL_TIMEOUT_SECONDS=300
# GTO_EXTERNAL_MAX_REQUEST_BYTES=4194304
# GTO_EXTERNAL_MAX_RESPONSE_BYTES=1048576
# Keep this unset/0 on the supported Linux solve server. Non-Linux process
# groups cannot contain descendants that daemonize with setsid(); setting 1 is
# an explicit unsafe acknowledgement for development tests only.
# GTO_EXTERNAL_ALLOW_BEST_EFFORT_PROCESS_CLEANUP=0
